      "updated": 1782073914700,
      "link": null,
      "locked": false,
      "text": "\"All publicly trusted TLS certificates must be submitted to\n at least two independent Certificate Transparency (CT) logs\n and include a Signed Certificate Timestamp (SCT) at the time \n of issuance, as mandated by the CA/Browser Forum Baseline Requirements \n and enforced by Google Chrome and Apple Safari.\"\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"All publicly trusted TLS certificates must be submitted to\n at least two independent Certificate Transparency (CT) logs\n and include a Signed Certificate Timestamp (SCT) at the time \n of issuance, as mandated by the CA/Browser Forum Baseline Requirements \n and enforced by Google Chrome and Apple Safari.\"\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
