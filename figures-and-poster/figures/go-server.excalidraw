    {
      "id": "4uiENLsrOl6oWNp8pUHw6",
      "type": "text",
      "x": -2567.1002475190153,
      "y": 1472.3270989776356,
      "width": 1244.195556640625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#9775fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
